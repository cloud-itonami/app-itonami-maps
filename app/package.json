{
  "name": "@itonami/maps",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "itonami": {
    "id": "network.itonami.maps",
    "title": "地図"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --max-old-space-size=4096 --test test/*.test.mjs",
    "tauri": "tauri",
    "build:desktop": "npm run build && tauri build --no-bundle",
    "build:android": "npm run build && tauri android build --apk --target aarch64"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
